GEMINI_API_KEY="your-google-ai-api-key"
GEMINI_MODEL="gemini-3.5-flash-lite"
EMBEDDING_MODEL="gemini-embedding-001"
# legacy_v2 مجمّد — v1 الفعلي محلي: e5-small ببعد 384 (query:/passage:)
# LOCAL_EMBEDDING_PATH="D:\Offline-600GB\07-RAG\models\e5-small"
# LOCAL_EMBEDDING_DIM=384
EMBEDDING_DIMENSIONS=768
# المفتاح الداخلي الذي توقّع به خدمة Realtime عند الاتصال بهذه الخدمة
INTERNAL_API_KEY="long-random-internal-secret"

# Rerank v1: heuristic فوري بلا BGE المحلي (كان 200ث/طلب على CPU)
RERANK_HEURISTIC_FIRST=1

# Postgres (docker-compose) — لا تضع القيمة الحقيقية هنا
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=ai_grammar_tutor