# عنوان بوابة Realtime كما يراها المتصفح (عام — يُضمن في البناء)
# محلياً: http://localhost:3001
# في الإنتاج: https://your-domain (المنفذ الوحيد المكشوف 3001)
NEXT_PUBLIC_API_URL=http://localhost:3001

# عنوان داخلي لطلبات السيرفر SSR فقط (سري — لا يصل للمتصفح)
# محلياً: اتركه فارغاً (= نفس العام)
# داخل Docker: http://realtime:3001 (اسم الخدمة بدل localhost)
INTERNAL_API_URL=
